{
    "name": "Doza: Your Personal Medic Assistant",
    "short_name": "Doza Medic",
    "description": "Healthcare platform connecting patients, medical professionals, and healthcare centers through comprehensive tools and free EMR systems.",
    "start_url": "/",
    "display": "standalone",
    "display_override": [
        "window-controls-overlay",
        "minimal-ui"
    ],
    "background_color": "#f0f9ff",
    "theme_color": "#017840",
    "orientation": "portrait-primary",
    "scope": "/",
    "id": "/",
    "lang": "en-US",
    "dir": "ltr",
    "categories": [
        "health",
        "medical",
        "productivity"
    ],
    "prefer_related_applications": false,
    "related_applications": [],
    "launch_handler": {
        "client_mode": "navigate-existing"
    },
    "handle_links": "preferred",
    "icons": [
        {
            "src": "/logo.png",
            "sizes": "500x500",
            "type": "image/png",
            "purpose": "any"
        },
        {
            "src": "/maskable/maskable_icon_x48.png",
            "sizes": "48x48",
            "type": "image/png",
            "purpose": "maskable"
        },
        {
            "src": "/maskable/maskable_icon_x72.png",
            "sizes": "72x72",
            "type": "image/png",
            "purpose": "maskable"
        },
        {
            "src": "/maskable/maskable_icon_x96.png",
            "sizes": "96x96",
            "type": "image/png",
            "purpose": "maskable"
        },
        {
            "src": "/maskable/maskable_icon_x128.png",
            "sizes": "128x128",
            "type": "image/png",
            "purpose": "maskable"
        },
        {
            "src": "/maskable/maskable_icon_x192.png",
            "sizes": "192x192",
            "type": "image/png",
            "purpose": "any maskable"
        },
        {
            "src": "/maskable/maskable_icon_x384.png",
            "sizes": "384x384",
            "type": "image/png",
            "purpose": "maskable"
        },
        {
            "src": "/maskable/maskable_icon_x512.png",
            "sizes": "512x512",
            "type": "image/png",
            "purpose": "any maskable"
        },
        {
            "src": "/maskable/maskable_icon.png",
            "sizes": "783x783",
            "type": "image/png",
            "purpose": "maskable"
        }
    ],
    "screenshots": [
        {
            "src": "/screenshot-mobile.png",
            "sizes": "375x812",
            "type": "image/png",
            "form_factor": "narrow",
            "label": "Doza mobile interface"
        },
        {
            "src": "/screenshot-desktop.png",
            "sizes": "1920x1080",
            "type": "image/png",
            "form_factor": "wide",
            "label": "Doza desktop dashboard"
        }
    ],
    "shortcuts": [
        {
            "name": "Book Appointment",
            "short_name": "Book",
            "description": "Schedule a new session with a medic",
            "url": "/dashboard/appointments/new",
            "icons": [
                {
                    "src": "/maskable/maskable_icon_x192.png",
                    "sizes": "192x192",
                    "type": "image/png"
                }
            ]
        },
        {
            "name": "My Appointments",
            "short_name": "Appointments",
            "description": "View your upcoming and past medical appointments",
            "url": "/dashboard/appointments",
            "icons": [
                {
                    "src": "/maskable/maskable_icon_x192.png",
                    "sizes": "192x192",
                    "type": "image/png"
                }
            ]
        },
        {
            "name": "Find a Medic",
            "short_name": "Medics",
            "description": "Browse and filter available healthcare professionals",
            "url": "/dashboard?panel=medics",
            "icons": [
                {
                    "src": "/maskable/maskable_icon_x192.png",
                    "sizes": "192x192",
                    "type": "image/png"
                }
            ]
        },
        {
            "name": "Reviews",
            "short_name": "Reviews",
            "description": "Read patient feedback and ratings for medics",
            "url": "/dashboard?panel=reviews",
            "icons": [
                {
                    "src": "/maskable/maskable_icon_x192.png",
                    "sizes": "192x192",
                    "type": "image/png"
                }
            ]
        },
        {
            "name": "Medic Services",
            "short_name": "Services",
            "description": "Explore available medical services and packages",
            "url": "/dashboard?panel=services",
            "icons": [
                {
                    "src": "/maskable/maskable_icon_x192.png",
                    "sizes": "192x192",
                    "type": "image/png"
                }
            ]
        }
    ]
}